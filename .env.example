# ──────────────────────────────────────────────────────
# Annapurna Food Rescue — Environment Variables Template
# ──────────────────────────────────────────────────────
# Copy this file to .env and fill in your production values.
# NEVER commit .env to version control!
# ──────────────────────────────────────────────────────

# Spring Profile (use 'prod' for production deployment)
SPRING_PROFILES_ACTIVE=prod

# JWT Secret — Generate a strong random 64+ char hex string
# Example: openssl rand -hex 32
JWT_SECRET=your_secure_random_jwt_secret_here
JWT_EXPIRATION_MS=86400000

# MySQL Database
MYSQL_URL=jdbc:mysql://your-db-host:3306/food_rescue_db?useSSL=true&serverTimezone=UTC
MYSQL_USER=your_db_username
MYSQL_PASSWORD=your_db_password

# CORS — Your production frontend URL (comma-separated for multiple)
CORS_ORIGINS=https://yourdomain.com

# Server Port
PORT=8080
